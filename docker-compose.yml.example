services:
  # Instância Base do TSShara Monitor
  ups-monitor:
    image: ghcr.io/thalesgmartins/ups-tsshara-monitor:latest
    container_name: ups_monitor
    privileged: true
    devices:
      - /dev/ttyTSSHARA0:/dev/ttyTSSHARA0
    env_file: ".env"
    restart: unless-stopped
