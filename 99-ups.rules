# =============================================================================
# /etc/udev/rules.d/99-ups.rules
# -----------------------------------------------------------------------------
# Cria symlinks estáveis (/dev/TSSHARA0, /dev/TSSHARA1) para os nobreaks
# TS Shara UPS SYAL IN conectados via conversor USB-Serial CH340.
#
# Todos os cabos CH340 compartilham o mesmo par Vendor/Product:
#   idVendor  = 1a86
#   idProduct = 7523
# Por isso NÃO dá para diferenciá-los por esses IDs. A distinção é feita pela
# PORTA USB FÍSICA, via KERNELS=="1-1.X".
#
# Como descobrir o valor de KERNELS de cada nobreak:
#   1) Desconecte e reconecte APENAS o cabo do nobreak em questão.
#   2) Rode:  dmesg | grep ttyUSB | tail -n 5
#   3) Procure algo como:
#        usb 1-1.3: ch341-uart converter now attached to ttyUSB1
#      O trecho "1-1.3" é o KERNELS desse nobreak.
#   4) Repita para cada nobreak e substitua os valores abaixo.
#
# Depois de editar este arquivo, aplique as regras com:
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#   ls -l /dev/TSSHARA*
# =============================================================================

# Nobreak 1  ->  /dev/TSSHARA0   (ajuste o KERNELS para a sua porta física)
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", KERNELS=="1-1.2", SYMLINK+="TSSHARA0"

# Nobreak 2  ->  /dev/TSSHARA1   (ajuste o KERNELS para a sua porta física)
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", KERNELS=="1-1.3", SYMLINK+="TSSHARA1"

# Se você tiver apenas UM nobreak, mantenha só a primeira linha (TSSHARA0)
# e remova/comente a segunda.
