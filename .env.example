# =============================================================================
# ups-tsshara-monitor — arquivo de ambiente de exemplo
# -----------------------------------------------------------------------------
# Copie este arquivo para cada instância/nobreak, ex.: NB-01.env, NB-02.env
# e ajuste os valores. Use um SERVER_NAME ÚNICO por container.
# =============================================================================

# --- Identificação --------------------------------------------------------
# Compõe o tópico MQTT e o nome do dispositivo no Home Assistant.
SERVER_NAME=ups_monitor_nb_01

# --- MQTT -----------------------------------------------------------------
# Se MQTT_HOST ficar vazio, o serviço roda apenas em modo leitura da serial
# (útil para validar a comunicação com o nobreak, sem publicar nada).
MQTT_HOST=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

# Prefixo do tópico de auto-discovery do Home Assistant.
# O tópico base final fica: ${MQTT_PREFIX}/${SERVER_NAME}
MQTT_PREFIX=homeassistant/sensor

# --- Serial ---------------------------------------------------------------
# Porta serial DENTRO do container. Mantenha o padrão se o docker-compose
# mapear o device do host para /dev/ttyTSSHARA0.
SERIAL_PORT=/dev/ttyTSSHARA0
SERIAL_BAUD=9600
SERIAL_SLAVE_ID=1

# Intervalo de leitura, em segundos.
SERIAL_POLL_SECS=5
